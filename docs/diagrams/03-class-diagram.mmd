classDiagram
  %% These are TypeScript types and exported service modules, not instantiated service classes.
  class ApparatusVariant {
    +id: number
    +apparatus_id: number
    +name: string
    +total_stock: number
    +available_stock: number
    +status: string
  }
  class ApparatusRecord {
    +id: number
    +name: string
    +category: string
    +total_stock: number
    +available_stock: number
    +status: string
    +icon: string
    +variants: ApparatusVariant[]
  }
  class CatalogMachine {
    +id: number
    +name: string
    +model: string or null
    +specifications: string or null
    +status: MachineStatus
    +notes: string or null
    +created_at: string
    +updated_at: string
  }
  class Student {
    +studentId: string
    +name: string
    +course: string
    +yearLevel: string
  }
  class StudentRecord {
    +student_id: string
    +full_name: string
    +course: string
    +year_level: number
  }
  class LabNotice {
    +id: number
    +title: string
    +category: NoticeCategory
    +body: string
    +pinned: boolean
    +created_at: string
  }
  class StudentNotification {
    +id: number
    +event_type: StudentNotificationEvent
    +message: string
    +href: string or null
    +created_at: string
    +read_at: string or null
  }
  class StaffLoanItem {
    +name: string
    +quantity: number
  }
  class StaffLoan {
    +loanId: number
    +studentId: string
    +studentName: string
    +items: StaffLoanItem[]
    +borrowedAt: string
    +dueAt: string
    +status: StaffLoanStatus
    +remarks: string or null
  }
  class BorrowingHistoryItem {
    +loanItemId: number
    +name: string
    +quantity: number
    +returnedQuantity: number
    +activeQuantity: number
  }
  class StudentBorrowingHistory {
    +studentId: string
    +studentName: string
    +loans: array
  }
  class MachineStatus {
    <<type alias>>
    available
    in_use
    maintenance
    archived
  }
  class StaffLoanStatus {
    <<type alias>>
    Active
    Overdue
  }
  class NoticeCategory {
    <<type alias>>
    Schedule
    Safety
    Announcements
  }
  class StudentNotificationEvent {
    <<type alias>>
  }
  %% StudentNotificationEvent values: Reservation, Reservation Update, Cancellation Request, Borrow, Return, Lab Notice.
  %% ApparatusVariant and ApparatusRecord status values: Active, Inactive.


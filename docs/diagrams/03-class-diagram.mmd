  ApparatusRecord "1" *-- "0..*" ApparatusVariant : variants
  StaffLoan "1" *-- "1..*" StaffLoanItem : items
  StudentBorrowingHistory "1" *-- "0..*" BorrowingHistoryItem : loan items
